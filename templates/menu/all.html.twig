{% extends 'layout/entity_list.html.twig' %}
{% set main_route = 'KejawenLab\\ApiSkeleton\\Admin\\Controller\\Menu\\Main' %}
{% set columns = [] %}
{% for property in properties %}
    {% if 'id' != property.name and
                                'routeName' != property.name and
                                'adminOnly' != property.name and
                                'extra' != property.name %}{% set columns = columns|merge([property]) %}{% endif %}
{% endfor %}
{% block download_action %}
<a class="btn btn-outline-secondary" href="{{- path('KejawenLab\\ApiSkeleton\\Admin\\Controller\\Menu\\Download') -}}"><i class="cil-arrow-circle-bottom mr-1" aria-hidden="true"></i>{{ 'sas.table.action.download'|trans({}, 'tables') }}</a>
{% endblock %}
{% block entity_cell %}
{%- if 'parent' == property.name -%}
    {%- set parent = attribute(data, property.name) -%}
    {%- if parent -%}
        <span>{{- parent.name ~ ' (' ~ parent.code ~ ')' -}}</span>
    {%- else -%}
        <span>-</span>
    {%- endif -%}
{%- elseif 'showable' == property.name -%}
    <span>
        {%- if attribute(data, property.name) -%}
            <span class="badge badge-success">{{- 'sas.page.menu.show' | trans({}, 'pages') -}}</span>
        {%- else -%}
            <span class="badge badge-secondary">{{- 'sas.page.menu.not_show' | trans({}, 'pages') -}}</span>
        {%- endif -%}
    </span>
{%- else -%}
    <span>{{- attribute(data, property.name) -}}</span>
{%- endif -%}
{% endblock %}
{% block entity_actions %}
<a href="{{- path('KejawenLab\\ApiSkeleton\\Admin\\Controller\\Menu\\Get', {id: data.id}) -}}" class="btn btn-sm btn-outline-secondary">
    {{- 'sas.table.action.view' | trans({}, 'tables') -}}
</a>
{%- if is_granted('edit', menu) -%}
    <a href="{{- path('KejawenLab\\ApiSkeleton\\Admin\\Controller\\Menu\\Put', ({id: data.id}) | merge(app.request.query.all)) -}}" class="btn btn-sm btn-outline-info">
        {{- 'sas.table.action.edit' | trans({}, 'tables') -}}
    </a>
{%- endif -%}
{%- if is_granted('delete', menu) -%}
    <button type="button"
            data-path="{{- path('KejawenLab\\ApiSkeleton\\Admin\\Controller\\Menu\\Delete', {id: data.id}) -}}"
            data-notification="{{- 'sas.notification.delete.message' | trans({'%data%': data.name}, 'notifications')|striptags -}}"
            class="btn btn-sm btn-outline-danger delete"
            data-toggle="modal"
            data-target="#sasDeleteModal"
    >
        {{- 'sas.table.action.delete' | trans({}, 'tables') -}}
    </button>
{%- endif -%}
{% endblock %}
