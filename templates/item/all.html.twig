{% extends 'layout/entity_list.html.twig' %}
{% set main_route = 'KejawenLab\\Application\\Admin\\Controller\\Item\\Main' %}
{% set columns = [] %}
{% for property in properties %}
    {% if 'id' != property.name %}{% set columns = columns|merge([property]) %}{% endif %}
{% endfor %}
{% block download_action %}
<a class="btn btn-outline-secondary" href="{{- path('KejawenLab\\Application\\Admin\\Controller\\Item\\Download') -}}"><i class="cil-arrow-circle-bottom mr-1" aria-hidden="true"></i>{{ 'sas.table.action.download'|trans({}, 'tables') }}</a>
{% endblock %}
{% block entity_cell %}
<span>
    {%- if property.name == 'status' -%}
        {%- include 'item/status.html.twig' with {expirable: data.status} only -%}
    {%- elseif property.name == 'unit' -%}
        {{- data.unit ? data.unit.name : 'Belum ditentukan' -}}
    {%- elseif property.name == 'category' -%}
        {{- data.category ? data.category.name : '-' -}}
    {%- else -%}
        {{- attribute(data, property.name) -}}
    {%- endif -%}
</span>
{% endblock %}
{% block entity_actions %}
<a href="{{- path('KejawenLab\\Application\\Admin\\Controller\\Item\\Get', {id: data.id}) -}}" class="btn btn-sm btn-outline-secondary">
    {{- 'sas.table.action.view' | trans({}, 'tables') -}}
</a>
{%- if is_granted('edit', menu) -%}
    <a href="{{- path('KejawenLab\\Application\\Admin\\Controller\\Item\\Put', ({id: data.id}) | merge(app.request.query.all)) -}}" class="btn btn-sm btn-outline-info">
        {{- 'sas.table.action.edit' | trans({}, 'tables') -}}
    </a>
{%- endif -%}
{%- if is_granted('delete', menu) -%}
    <button type="button"
            data-path="{{- path('KejawenLab\\Application\\Admin\\Controller\\Item\\Delete', {id: data.id}) -}}"
            data-notification="{{- 'sas.notification.delete.message' | trans({'%data%': semart_print(data)}, 'notifications')|striptags -}}"
            class="btn btn-sm btn-outline-danger delete"
            data-toggle="modal"
            data-target="#sasDeleteModal"
    >
        {{- 'sas.table.action.delete' | trans({}, 'tables') -}}
    </button>
{%- endif -%}
{% endblock %}
