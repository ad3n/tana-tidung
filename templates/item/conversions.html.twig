{% extends 'layout/main.html.twig' %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('plugins/select2/css/select2.min.css') }}">
    <link rel="stylesheet" href="{{ asset('plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css') }}">
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('plugins/select2/js/select2.full.min.js') }}"></script>
    <script>
        $(document).ready(function () {
            $('.select2').select2({theme: 'bootstrap4', width: '100%'});
        });
    </script>
{% endblock %}
{% block content %}
    {% set can_edit = is_granted('edit', convert_to_menu('item')) %}
    <div class="row">
        <div class="col-lg-6 col-md-12">
            <div class="card">
                <div class="card-header"><h4>{{ 'sas.page.item_conversion.title' | trans({}, 'pages') }} — {{ data.name }}</h4></div>
                <div class="card-body">
                    <p>{{ 'sas.table.column.item.unit' | trans({}, 'tables') }}: <strong>{{ data.unit ? data.unit.name : ('unit.type.unclassified' | trans({}, 'tables')) }}</strong></p>
                    <table class="table">
                        <thead><tr><th>{{ 'sas.form.field.item_conversion.unit' | trans({}, 'forms') }}</th><th>{{ 'sas.form.field.item_conversion.factor' | trans({}, 'forms') }}</th>{% if can_edit %}<th>{{ 'sas.page.item_conversion.actions' | trans({}, 'pages') }}</th>{% endif %}</tr></thead>
                        <tbody>
                        {% for conversion in conversions %}
                            <tr>
                                <td>1 {{ conversion.unit.name }}</td>
                                <td>{{ conversion.factor | number_format(2, ',', '.') }} {{ data.unit.name }}</td>
                                {% if can_edit %}<td>
                                    <form method="post" action="{{ path('KejawenLab\\Application\\Admin\\Controller\\Item\\DeleteConversion', {id: data.id, conversionId: conversion.id}) }}" onsubmit="return confirm({{ 'sas.page.item_conversion.delete_confirm' | trans({}, 'pages') | json_encode | e('html_attr') }})">
                                        <button class="btn btn-sm btn-outline-danger" type="submit">{{ 'sas.page.item_conversion.delete' | trans({}, 'pages') }}</button>
                                    </form>
                                </td>{% endif %}
                            </tr>
                        {% else %}<tr><td colspan="{{ can_edit ? 3 : 2 }}">{{ 'sas.page.item_conversion.empty' | trans({}, 'pages') }}</td></tr>{% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="card-footer"><a class="btn btn-outline-secondary" href="{{ path('KejawenLab\\Application\\Admin\\Controller\\Item\\Get', {id: data.id}) }}">{{ 'sas.page.item_conversion.back' | trans({}, 'pages') }}</a></div>
            </div>
        </div>
        {% if can_edit %}
            <div class="col-lg-6 col-md-12">
                <div class="card">
                    <div class="card-header"><h4>{{ 'sas.page.item_conversion.add' | trans({}, 'pages') }}</h4></div>
                    {% if data.unit and form.unit.vars.choices is empty %}
                        <div class="card-body">
                            <p>{{ 'sas.page.item_conversion.no_units' | trans({}, 'pages') }}</p>
                            {% if data.unit.type == 'unclassified' %}
                                <p>{{ 'sas.page.item_conversion.classify' | trans({'%unit%': data.unit.name}, 'pages') }}</p>
                            {% else %}
                            <p>{{ 'sas.page.item_conversion.eligible' | trans({'%unit%': data.unit.name}, 'pages') }}</p>
                            <p>{{ 'sas.page.item_conversion.example' | trans({}, 'pages') }}</p>
                            {% endif %}
                            {% if is_granted('view', convert_to_menu('unit')) %}
                                <a class="btn btn-outline-info" href="{{ path('KejawenLab\\Application\\Admin\\Controller\\Unit\\Main') }}">{{ 'sas.page.item_conversion.open_units' | trans({}, 'pages') }}</a>
                            {% endif %}
                        </div>
                    {% elseif data.unit %}
                        {{ form_start(form) }}
                        <div class="card-body">
                            {{ form_widget(form) }}
                        </div>
                        <div class="card-footer"><button type="submit" class="btn btn-outline-primary">{{ 'sas.page.item_conversion.save' | trans({}, 'pages') }}</button><a href="{{ path('KejawenLab\\Application\\Admin\\Controller\\Item\\Conversions', {id: data.id}) }}" class="btn btn-outline-secondary ml-1">{{ 'sas.page.item_conversion.cancel' | trans({}, 'pages') }}</a></div>
                        {{ form_end(form) }}
                    {% else %}<div class="card-body">{{ 'sas.page.item_conversion.missing_base' | trans({}, 'pages') }}</div>{% endif %}
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
