{% extends 'layout/entity_list.html.twig' %}
{% set main_route = 'KejawenLab\\ApiSkeleton\\Admin\\Controller\\Group\\Main' %}
{% set columns = [] %}
{% for property in properties %}
    {% if 'id' != property.name %}{% set columns = columns|merge([property]) %}{% endif %}
{% endfor %}
{% block download_action %}
<a class="btn btn-outline-secondary" href="{{- path('KejawenLab\\ApiSkeleton\\Admin\\Controller\\Group\\Download') -}}"><i class="cil-arrow-circle-bottom mr-1" aria-hidden="true"></i>{{ 'sas.table.action.download'|trans({}, 'tables') }}</a>
{% endblock %}
{% block entity_cell %}
<span>{{- attribute(data, property.name) -}}</span>
{% endblock %}
{% block entity_actions %}
<a href="{{- path('KejawenLab\\ApiSkeleton\\Admin\\Controller\\Group\\Get', {id: data.id}) -}}" class="btn btn-sm btn-outline-secondary">
    {{- 'sas.table.action.view' | trans({}, 'tables') -}}
</a>
{%- if is_granted('edit', menu) -%}
    <a href="{{- path('KejawenLab\\ApiSkeleton\\Admin\\Controller\\Group\\Put', ({id: data.id}) | merge(app.request.query.all)) -}}" class="btn btn-sm btn-outline-info">
        {{- 'sas.table.action.edit' | trans({}, 'tables') -}}
    </a>
{%- endif -%}
{%- if is_granted('delete', menu) -%}
    <button type="button"
            data-path="{{- path('KejawenLab\\ApiSkeleton\\Admin\\Controller\\Group\\Delete', {id: data.id}) -}}"
            data-notification="{{- 'sas.notification.delete.message' | trans({'%data%': data.name}, 'notifications')|striptags -}}"
            class="btn btn-sm btn-outline-danger delete"
            data-toggle="modal"
            data-target="#sasDeleteModal"
    >
        {{- 'sas.table.action.delete' | trans({}, 'tables') -}}
    </button>
{%- endif -%}
{% endblock %}
