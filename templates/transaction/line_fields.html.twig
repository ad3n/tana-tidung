{% trans_default_domain 'pages' %}
                        <div class="form-group col-md-6"><label for="line-item">{{ 'transaction.item'|trans }}</label><select class="form-control select2" id="line-item" name="item_id" required><option value="">{{ 'transaction.choose'|trans }}</option>{% for item in items %}{% if item.unit %}<option value="{{ item.id }}" data-code="{{ item.code }}" data-name="{{ item.name }}" data-expirable="{{ item.status ? 1 : 0 }}" {% if line_values.item_id|default('') == item.id %}selected{% endif %}>{{ item.code }} — {{ item.name }}</option>{% endif %}{% endfor %}</select></div>
                        <div class="form-group col-md-6"><label for="line-unit">{{ 'transaction.unit'|trans }}</label><select class="form-control select2" id="line-unit" name="unit_id" required><option value="">{{ 'transaction.choose'|trans }}</option>{% for item in items %}{% if item.unit %}<option data-unit-name="{{ item.unit.name }}" data-factor="1" value="{{ item.unit.id }}" data-item="{{ item.id }}" {% if line_values.unit_id|default('') == item.unit.id and line_values.item_id|default('') == item.id %}selected{% endif %}>{{ item.unit.name }}</option>{% endif %}{% endfor %}{% for conversion in conversions %}<option data-unit-name="{{ conversion.unit.name }}" data-factor="{{ conversion.factor }}" value="{{ conversion.unit.id }}" data-item="{{ conversion.item.id }}" {% if line_values.unit_id|default('') == conversion.unit.id and line_values.item_id|default('') == conversion.item.id %}selected{% endif %}>{{ conversion.unit.name }} ({{ conversion.factor|number_format(2, ',', '.')|trim('0', 'right')|trim(',', 'right') }} {{ conversion.item.unit.code }})</option>{% endfor %}</select></div>
                        <div class="form-group col-md-6"><label for="line-qty">{{ 'transaction.qty'|trans }}</label><input class="form-control" id="line-qty" name="qty" inputmode="decimal" value="{{ line_values.qty|default('') }}" required><small>{{ 'transaction.qty_help'|trans }}</small></div>
                        {% if (transaction ? transaction.type.value : values.type) == 1 %}
                            <div class="form-group col-md-6"><label for="line-price" class="required">{{ 'transaction.price'|trans }}</label><div class="input-group"><div class="input-group-prepend"><span class="input-group-text">Rp</span></div><input class="form-control" type="number" id="line-price" name="price" required min="0" step="0.01" inputmode="decimal" value="{{ line_values.price|default('') }}" aria-describedby="line-price-help"></div><small id="line-price-help">{{ 'transaction.price_help'|trans }}</small></div>
                            <div class="form-group col-12"><label for="line-total">{{ 'transaction.line_amount'|trans }}</label><output id="line-total" class="form-control-plaintext font-weight-bold" for="line-qty line-price" aria-live="polite">-</output></div>
                            <div class="form-group col-md-6"><label for="line-batch">{{ 'transaction.batch'|trans }}</label><input class="form-control" id="line-batch" name="batch_number" aria-describedby="line-batch-help" maxlength="100" value="{{ line_values.batch_number|default('') }}"><small id="line-batch-help" class="form-text text-muted">{{ 'transaction.batch_help'|trans }}</small></div>
                            <div class="form-group col-md-6"><label for="line-expiry">{{ 'transaction.expiry'|trans }}</label><input class="form-control" type="date" id="line-expiry" name="expiry_date" value="{{ line_values.expiry_date|default('') }}"><small>{{ 'transaction.expiry_help'|trans }}</small></div>
                        {% else %}
                            <div class="form-group col-md-6"><label for="line-lot">{{ 'transaction.batch'|trans }}</label><select class="form-control select2" id="line-lot" name="stock_lot_id"><option value="">{{ 'transaction.fefo'|trans }}</option>{% for stock in stocks %}{% if stock.location == 'AVAILABLE' %}<option value="{{ stock.stock_lot_id }}" data-item="{{ stock.item_id }}" {% if line_values.stock_lot_id|default('') == stock.stock_lot_id %}selected{% endif %}>{{ stock.batch_number }} — {{ stock.qty }} {{ stock.unit }} — {{ stock.expiry_date|default('-') }}</option>{% endif %}{% endfor %}</select></div>
                        {% endif %}
                        {% if (transaction ? transaction.type.value : values.type) != 1 %}
                            <div id="line-stock" class="form-group col-12" hidden>
                                <div class="alert alert-info mb-0" role="status" aria-live="polite">
                                    {{ 'transaction.available_stock'|trans }}: <span id="line-stock-value" class="font-weight-bold"></span>
                                </div>
                            </div>
                        {% endif %}
