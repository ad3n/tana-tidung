{% extends 'transaction/base.html.twig' %}
{% trans_default_domain 'pages' %}
{% block content %}
    {% set menu = convert_to_menu('transaction') %}
    {% set can_revise = transaction.status.value == 7 and can_operate and is_granted('edit', menu) %}
    {% set editable = (can_revise and revising) and can_operate and is_granted('edit', menu) %}
    {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
    <div class="row">
        <div class="col-12">
            <div class="card transaction-invoice">
                {% include 'transaction/invoice_header.html.twig' %}
                {% include 'transaction/invoice_details.html.twig' %}
                <input type="hidden" id="transaction-type" value="{{ transaction.type.value }}">
                <input type="hidden" id="transaction-from" value="{{ transaction.fromOrganization ? transaction.fromOrganization.id : '' }}">
                <input type="hidden" id="transaction-date" value="{{ transaction.date|date('Y-m-d') }}">
                <div class="card-body table-responsive transaction-invoice-items"><table class="table mb-0"><thead><tr><th>{{ 'transaction.item_code'|trans }}</th><th>{{ 'transaction.item'|trans }}</th><th>{{ 'transaction.qty'|trans }}</th><th>{{ 'transaction.base_qty'|trans }}</th><th>{{ 'transaction.batch_details'|trans }}</th>{% if editable %}<th></th>{% endif %}</tr></thead><tbody>
                {% for line in data.items %}<tr>
                    <td>{{ line.item_code }}</td><td>{{ line.item_name }}</td><td>{{ line.qty|number_format(2, ',', '.') }} {{ line.unit_name }}{% if line.unit_id != line.base_unit_id %} ({{ line.conversion_factor|number_format(2, ',', '.')|trim('0', 'right')|trim(',', 'right') }} {{ line.base_unit_code }}){% endif %}</td><td>{{ line.base_qty|number_format(2, ',', '.') }} {{ line.base_unit_name }}</td>
                    <td>
                        {% if line.allocations is not empty %}
                            <table class="table table-sm mb-0">
                                <thead><tr><th>{{ 'transaction.batch'|trans }}</th><th>{{ (transaction.type.value == 1 ? 'transaction.received_qty' : 'transaction.taken_qty')|trans }}</th><th>{{ 'transaction.expiry'|trans }}</th></tr></thead>
                                <tbody>{% for allocation in line.allocations %}
                                    <tr><td>{{ allocation.batch_number }}</td><td class="text-nowrap">{{ allocation.base_qty|number_format(6, ',', '.')|trim('0', 'right')|trim(',', 'right') }} {{ line.base_unit_name }}</td><td class="text-nowrap">{{ allocation.expiry_date ? allocation.expiry_date|date('d-m-Y') : '-' }}</td></tr>
                                {% endfor %}</tbody>
                            </table>
                        {% else %}
                            {{ line.batch_number|default(line.stock_lot_id ? 'transaction.selected_batch'|trans : 'transaction.auto_batch'|trans) }}<br>{{ line.expiry_date|default('') }}
                            {% if transaction.type.value != 1 %}<small class="text-muted">{{ 'transaction.batch_pending'|trans }}</small>{% endif %}
                        {% endif %}
                    </td>
                    {% if editable %}<td><form method="post"><input type="hidden" name="_operation" value="remove_line"><input type="hidden" name="line_id" value="{{ line.id }}"><button type="submit" class="btn btn-sm btn-outline-danger">{{ 'transaction.remove'|trans }}</button></form></td>{% endif %}
                </tr>{% else %}<tr><td colspan="6">{{ 'transaction.empty_items'|trans }}</td></tr>{% endfor %}
                </tbody></table></div>
            </div>
            <div class="d-flex justify-content-between flex-wrap mb-3">
                <div>{% if editable %}<button type="button" class="btn btn-primary" data-toggle="modal" data-target="#transaction-item-modal">{{ 'transaction.add_item'|trans }}</button>{% endif %}</div>
                <div class="transaction-action-buttons">
                    <a class="btn btn-outline-secondary" href="{{ path('KejawenLab\\Application\\Admin\\Controller\\Transaction\\Listing_' ~ {1: 'receipt', 2: 'transfer', 3: 'disposal'}[transaction.type.value]) }}">{{ 'transaction.back'|trans }}</a>
                    {% if can_revise and not revising %}
                        <a class="btn btn-outline-info" href="{{ path('KejawenLab\\Application\\Admin\\Controller\\Transaction\\Get', {id: transaction.id, revise: 1}) }}">{{ 'transaction.revise'|trans }}</a>
                    {% endif %}
                    {% for action in (revising ? [] : data.available_actions)|filter(action => action != 'submit') %}
                        {% if action in ['return', 'cancel'] %}
                            <button type="button" class="btn btn-outline-{{ action == 'return' ? 'warning' : 'danger' }}" data-toggle="modal" data-target="#transaction-{{ action }}-modal">{{ ('transaction.action.' ~ action)|trans }}</button>
                        {% else %}
                            <form method="post" class="transaction-action">
                                <input type="hidden" name="_operation" value="{{ action }}">
                                <button type="submit" class="btn btn-outline-primary">{{ ('transaction.action.' ~ action)|trans }}</button>
                            </form>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
    {% for action in data.available_actions %}
        {% if action in ['return', 'cancel'] %}
            <div class="modal fade" id="transaction-{{ action }}-modal" tabindex="-1" role="dialog" aria-labelledby="transaction-{{ action }}-title" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content">
                    <form method="post">
                        <input type="hidden" name="_operation" value="{{ action }}">
                        <div class="modal-header">
                            <h5 class="modal-title" id="transaction-{{ action }}-title">{{ ('transaction.action.' ~ action)|trans }}</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'transaction.back'|trans }}"><span aria-hidden="true">&times;</span></button>
                        </div>
                        <div class="modal-body">
                            <label for="reason-{{ action }}" class="required">{{ 'transaction.review_note'|trans }}</label>
                            <textarea id="reason-{{ action }}" name="note" class="form-control" rows="3" required maxlength="10000"></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">{{ 'transaction.back'|trans }}</button>
                            <button type="submit" class="btn btn-{{ action == 'return' ? 'warning' : 'danger' }}">{{ ('transaction.action.' ~ action)|trans }}</button>
                        </div>
                    </form>
                </div></div>
            </div>
        {% endif %}
    {% endfor %}
    {% if data.workflow_history is not empty %}
        <div class="card"><div class="card-header">{{ 'transaction.history'|trans }}</div><div class="card-body table-responsive">
            <table class="table mb-0"><thead><tr><th>{{ 'transaction.history_time'|trans }}</th><th>{{ 'transaction.history_actor'|trans }}</th><th>{{ 'transaction.actions'|trans }}</th><th>{{ 'transaction.review_note'|trans }}</th></tr></thead><tbody>
            {% for entry in data.workflow_history %}<tr><td>{{ entry.at|date('d-m-Y H:i') }}</td><td>{{ entry.actor_name }}</td><td>{{ ('transaction.action.' ~ entry.action)|trans }}</td><td>{{ entry.note|default('-') }}</td></tr>{% endfor %}
            </tbody></table>
        </div></div>
    {% endif %}
    {% if editable %}{% include 'transaction/item_modal.html.twig' %}{% endif %}
{% endblock %}
