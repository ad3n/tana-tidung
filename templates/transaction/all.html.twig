{% extends 'transaction/base.html.twig' %}
{% trans_default_domain 'pages' %}
{% block content %}
    <div class="row" id="transaction-list">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4>{{ page_title|trans }}</h4>
                    <form method="get" class="row">
                        {% if show_origin %}
                            <div class="col-md-5 mb-2 mb-md-0">
                                <select id="transaction-list-organization" name="organization_id" class="form-control select2" aria-label="{{ 'transaction.organization'|trans }}">
                                    <option value="">{{ 'transaction.all_organizations'|trans }}</option>
                                    {% for organization in organizations %}<option value="{{ organization.id }}" {% if selected_organization == organization.id %}selected{% endif %}>{{ organization.name }}</option>{% endfor %}
                                </select>
                            </div>
                        {% endif %}
                        <div class="{{ show_origin ? 'col-md-7' : 'col-12' }}">
                            <div class="input-group">
                                <input type="search" id="transaction-list-search" name="q" class="form-control" value="{{ app.request.query.get('q') }}" placeholder="{{ search_label|trans }}" aria-label="{{ search_label|trans }}">
                                <div class="input-group-append">
                                    <button type="submit" class="btn btn-default"><i class="cil-search pr-1 align-middle" aria-hidden="true"></i>{{ 'sas.table.action.search'|trans({}, 'tables') }}</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="card-body table-responsive">
                    <table class="table transaction-list-table mb-0">
                    <thead>
                        <tr>
                            <th>{{ 'transaction.code'|trans }}</th>
                            {% if is_receipt %}
                                <th>{{ 'transaction.reference'|trans }}</th>
                                {% if show_origin %}<th>{{ 'transaction.organization'|trans }}</th>{% endif %}
                                <th>{{ 'transaction.fiscal_year'|trans }}</th>
                                <th>{{ 'transaction.list.source'|trans }}</th>
                            {% elseif is_transfer %}
                                <th>{{ 'transaction.reference_sk'|trans }}</th>
                                {% if show_origin %}<th>{{ 'transaction.from'|trans }}</th>{% endif %}
                                <th>{{ 'transaction.to'|trans }}</th>
                                <th>{{ 'transaction.fiscal_year'|trans }}</th>
                            {% else %}
                                <th>{{ 'transaction.reference_sk'|trans }}</th>
                                {% if show_origin %}<th>{{ 'transaction.organization'|trans }}</th>{% endif %}
                                <th>{{ 'transaction.fiscal_year'|trans }}</th>
                            {% endif %}
                            {% if is_receipt %}<th class="text-right">{{ 'transaction.total_amount'|trans }}</th>{% endif %}
                            <th>{{ 'transaction.status'|trans }}</th>
                            <th class="transaction-table-actions">{{ 'transaction.actions'|trans }}</th>
                        </tr>
                    </thead><tbody>
                    {% for transaction in list.items %}
                        <tr>
                            <td>{{ transaction.code }}<br><small>{{ transaction.date|date('d-m-Y') }}</small></td>
                            {% if is_receipt %}
                                <td>{{ transaction.referenceNumber|default('-') }}</td>
                                {% if show_origin %}<td>{{ transaction.toOrganization ? transaction.toOrganization.name : '-' }}</td>{% endif %}
                                <td>{{ transaction.fiscalYear.year }}</td>
                                <td>{{ transaction.source ? transaction.source.name : '-' }}</td>
                            {% elseif is_transfer %}
                                <td>{{ transaction.referenceNumber|default('-') }}</td>
                                {% if show_origin %}<td>{{ transaction.fromOrganization ? transaction.fromOrganization.name : '-' }}</td>{% endif %}
                                <td>{{ transaction.toOrganization ? transaction.toOrganization.name : '-' }}</td>
                                <td>{{ transaction.fiscalYear.year }}</td>
                            {% else %}
                                <td>{{ transaction.referenceNumber|default('-') }}</td>
                                {% if show_origin %}<td>{{ transaction.fromOrganization ? transaction.fromOrganization.name : '-' }}</td>{% endif %}
                                <td>{{ transaction.fiscalYear.year }}</td>
                            {% endif %}
                            {% if is_receipt %}
                                {% set amount = list.amounts[transaction.id] %}
                                <td class="text-right text-nowrap">
                                    {{ amount.value is not null ? 'Rp ' ~ (amount.value|number_format(2, ',', '.')) : '-' }}
                                </td>
                            {% endif %}
                            <td>{% include 'transaction/status.html.twig' %}</td>
                            <td class="transaction-table-actions"><a class="btn btn-sm btn-outline-secondary" href="{{ path('KejawenLab\\Application\\Admin\\Controller\\Transaction\\Get', {id: transaction.id}) }}">{{ 'transaction.view'|trans }}</a></td>
                        </tr>
                    {% else %}<tr><td colspan="{{ is_receipt ? (show_origin ? 8 : 7) : (is_transfer ? (show_origin ? 7 : 6) : (show_origin ? 6 : 5)) }}">{{ 'transaction.empty'|trans }}</td></tr>{% endfor %}
                    </tbody></table>
                </div>
                {% if list.total > 25 or list.page > 1 %}
                <div class="card-footer">
                    {% if list.page > 1 %}<a class="btn btn-outline-secondary" href="{{ path(app.request.attributes.get('_route'), {page: list.page - 1, q: app.request.query.get('q'), organization_id: selected_organization}) }}">←</a>{% endif %}
                    {{ list.page }}
                    {% if list.total > list.page * 25 %}<a class="btn btn-outline-secondary" href="{{ path(app.request.attributes.get('_route'), {page: list.page + 1, q: app.request.query.get('q'), organization_id: selected_organization}) }}">→</a>{% endif %}
                </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('plugins/select2/js/select2.full.min.js') }}"></script>
    <script>$(function () { $('#transaction-list-organization').select2({theme: 'bootstrap4', width: '100%'}); });</script>
{% endblock %}
