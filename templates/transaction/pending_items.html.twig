{% trans_default_domain 'pages' %}
<table class="table mb-0">
    <thead>
        <tr>
            {% for label in ['item_code', 'item_name', 'expiry', 'batch', 'qty', 'unit'] %}
                <th>{{ ('transaction.' ~ label)|trans }}</th>
            {% endfor %}
            {% if transaction_type == 1 %}<th class="text-right">{{ 'transaction.price'|trans }}</th><th class="text-right">{{ 'transaction.line_amount'|trans }}</th>{% endif %}
            <th>{{ 'transaction.actions'|trans }}</th>
        </tr>
    </thead>
    <tbody id="transaction-pending-items"></tbody>
</table>
<p id="transaction-empty-items" class="text-muted mb-0">{{ 'transaction.empty_items'|trans }}</p>
