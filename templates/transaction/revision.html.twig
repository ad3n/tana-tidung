{% extends 'transaction/base.html.twig' %}
{% trans_default_domain 'pages' %}
{% block content %}
    {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
    <div id="transaction-stock-error" class="alert alert-danger" role="alert" hidden></div>
    <form method="post" id="transaction-create-form" class="mb-4">
        <input type="hidden" name="_operation" value="revision">
        <div class="card transaction-invoice">
            {% include 'transaction/invoice_header.html.twig' %}
            {% include 'transaction/header_fields.html.twig' %}
            <div class="card-body table-responsive transaction-invoice-items">
                {% include 'transaction/pending_items.html.twig' with {transaction_type: transaction.type.value} %}
            </div>
        </div>
        <div class="d-flex justify-content-between flex-wrap">
            <button type="button" class="btn btn-primary mb-2" data-toggle="modal" data-target="#transaction-item-modal">{{ 'transaction.add_item'|trans }}</button>
            <div class="transaction-action-buttons">
                <a class="btn btn-outline-secondary" href="{{ path('KejawenLab\\Application\\Admin\\Controller\\Transaction\\Get', {id: transaction.id}) }}">{{ 'transaction.back'|trans }}</a>
                <button type="submit" class="btn btn-outline-info">{{ 'transaction.revision_done'|trans }}</button>
            </div>
        </div>
    </form>
    {% include 'transaction/item_modal.html.twig' %}
    <script id="transaction-pending-data" type="application/json">{{ values.items|default([])|json_encode(15)|raw }}</script>
{% endblock %}
