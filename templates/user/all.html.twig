{% extends 'layout/entity_list.html.twig' %}
{% set main_route = 'KejawenLab\\ApiSkeleton\\Admin\\Controller\\User\\Main' %}
{% set columns = [] %}
{% for property in properties %}
    {% if 'id' != property.name and
                                    'password' != property.name and
                                    'plainPassword' != property.name and
                                    'profileImage' != property.name and
                                    'deviceId' != property.name and
                                    'file' != property.name and
                                    'lastLogin' != property.name %}{% set columns = columns|merge([property]) %}{% endif %}
{% endfor %}
{% block download_action %}
<a class="btn btn-outline-secondary" href="{{- path('KejawenLab\\ApiSkeleton\\Admin\\Controller\\User\\Download') -}}"><i class="cil-arrow-circle-bottom mr-1" aria-hidden="true"></i>{{ 'sas.table.action.download'|trans({}, 'tables') }}</a>
{% endblock %}
{% block entity_cell %}
{%- if 'group' == property.name -%}
    {%- set group = attribute(data, property.name) -%}
    <span>{{- group.name ~ ' (' ~ group.code ~ ')' -}}</span>
{%- elseif 'supervisor' == property.name -%}
    {%- set supervisor = attribute(data, property.name) -%}
    {%- if supervisor -%}
        <span>{{- supervisor.fullName ~ ' (' ~ supervisor.username ~ ')' -}}</span>
    {%- else -%}
        <span>-</span>
    {%- endif -%}
{%- else -%}
    <span>{{- attribute(data, property.name) -}}</span>
{%- endif -%}
{% endblock %}
{% block entity_actions %}
<a href="{{- path('KejawenLab\\ApiSkeleton\\Admin\\Controller\\User\\Get', {id: data.id}) -}}" class="btn btn-sm btn-outline-secondary">
    {{- 'sas.table.action.view' | trans({}, 'tables') -}}
</a>
{%- if is_granted('edit', menu) -%}
    <a href="{{- path('KejawenLab\\ApiSkeleton\\Admin\\Controller\\User\\Put', ({id: data.id}) | merge(app.request.query.all)) -}}" class="btn btn-sm btn-outline-info">
        {{- 'sas.table.action.edit' | trans({}, 'tables') -}}
    </a>
{%- endif -%}
{%- if is_granted('delete', menu) -%}
    <button type="button"
        data-path="{{- path('KejawenLab\\ApiSkeleton\\Admin\\Controller\\User\\Delete', {id: data.id}) -}}"
        data-notification="{{- 'sas.notification.delete.message' | trans({'%data%': data.username}, 'notifications')|striptags -}}"
        class="btn btn-sm btn-outline-danger delete"
        data-toggle="modal"
        data-target="#sasDeleteModal"
    >
        {{- 'sas.table.action.delete' | trans({}, 'tables') -}}
    </button>
{%- endif -%}
{% endblock %}
